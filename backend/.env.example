# Environment variables for Bitcoin Playground
# Copy this file to .env and update the values

# Django Secret Key
SECRET_KEY=your-django-secret-key-here

# Mnemonic Encryption Key (32 bytes base64 encoded)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MNEMONIC_ENCRYPTION_KEY=your-mnemonic-encryption-key-here

# Debug Mode (set to False in production)
DEBUG=False

# Allowed Hosts (comma separated)
# Railway: add your Railway domain and custom domain
# e.g. ALLOWED_HOSTS=*.up.railway.app,api.playground.onebitebitcoin.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Railway automatically sets DATABASE_URL when PostgreSQL plugin is attached.
# For local dev, leave unset to use SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — comma-separated list of allowed frontend origins
# Railway: set to your Railway frontend URL and custom domain
# e.g. CORS_ALLOWED_ORIGINS=https://playground-frontend.up.railway.app,https://playground.onebitebitcoin.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:6173

# AI API Keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Financial data API keys
ECOS_API_KEY=your-ecos-api-key-here
FRED_API_KEY=your-fred-api-key-here
